# PortfolioView environment — copy to `.env` and fill in.
# docker compose reads `.env` automatically and passes these through to the
# `web` service (see docker-compose.yml). Never commit a filled-in `.env`.

# --- Invite-gated registration (backlog #006) ---
# Registration is closed if this is blank. Dev defaults to "dev-invite-code".
INVITE_CODE=dev-invite-code

# --- Market-data providers (backlog M2) ---
# Read from ENV by the adapters in app/lib/price_provider/. Never logged.

# Tiingo (primary prices) — https://api.tiingo.com — free: 1000 req/day, 50/hr,
# 500 unique symbols/month. Raw unadjusted EOD OHLCV + splitFactor + divCash.
TIINGO_API_KEY=

# Twelve Data (fallback prices, forward-delta only) — https://twelvedata.com —
# free: 800 credits/day. Used ONLY to patch recent EOD rows with adjust=none;
# never for backfill or split ingestion.
TWELVE_DATA_API_KEY=

# FMP (sector/industry metadata) — https://financialmodelingprep.com — free:
# 250 req/day. One-time /stable/profile lookup per ticker, cached in Postgres.
FMP_API_KEY=

# --- Production compose profile only (backlog #054) ---
# Required by `docker compose --profile production up db-prod web-prod`; the dev
# stack ignores them. Both are blank here on purpose — production has no
# fallback default and must fail closed. INVITE_CODE above is shared with dev,
# but the production service passes it through with no `:-` default, so blank
# means registration stays closed.

# Rails' secret_key_base (signed/encrypted cookies). Generate one with:
#   docker compose --profile production run --rm web-prod ./bin/rails secret
# or `openssl rand -hex 64`. Changing it invalidates every existing session.
SECRET_KEY_BASE=

# Password for the production Postgres role "app" (config/database.yml
# production block, and POSTGRES_PASSWORD for the db-prod container).
# Generate with `openssl rand -hex 24`. It is baked into the named volume the
# first time db-prod initializes — changing it later needs the volume recreated.
APP_DATABASE_PASSWORD=
