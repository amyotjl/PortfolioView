# PortfolioView environment — copy to `.env` and fill in.
# docker compose reads `.env` automatically and passes these through to the
# `web` service (see docker-compose.yml). Never commit a filled-in `.env`.

# --- Invite-gated registration (backlog #006) ---
# Registration is closed if this is blank. Dev defaults to "dev-invite-code".
INVITE_CODE=dev-invite-code

# --- Market-data providers (backlog M2) ---
# Read from ENV by the adapters in app/lib/price_provider/. Never logged.

# Tiingo (primary prices) — https://api.tiingo.com — free: 1000 req/day, 50/hr,
# 500 unique symbols/month. Raw unadjusted EOD OHLCV + splitFactor + divCash.
TIINGO_API_KEY=
